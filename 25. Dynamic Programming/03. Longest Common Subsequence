// Approach 1 : Memoisation 
// TC : O(N * M)
// SC : dp = O(N * M) + recursive stack space = O(N * M)

class Solution {
public:
    int lcs(int ind1, int ind2, string &s1, string &s2, vector<vector<int>> &dp){
        if(ind1 == s1.size() || ind2 == s2.size()){
            return 0;
        }

        if(dp[ind1][ind2] != -1) return dp[ind1][ind2];

        int notPick = 0 + max(lcs(ind1, ind2+1, s1, s2, dp) , lcs(ind1+1, ind2, s1, s2, dp));
        int pick = 0;
        if(s1[ind1] == s2[ind2]){
            pick = 1 + lcs(ind1+1, ind2+1, s1, s2, dp);
        }

        return dp[ind1][ind2] = max(pick, notPick);
    }
    int longestCommonSubsequence(string text1, string text2) {
        vector<vector<int>> dp(text1.size(), vector<int>(text2.size(), -1));
        return lcs(0,0,text1,text2,dp);
    }
};

// Approach 2 : Tabulation
// TC : O(N * M)
// SC : O(N * M) just for DP

class Solution {
public:
    int longestCommonSubsequence(string text1, string text2) {
        int n = text1.size(), m = text2.size();
        vector<vector<int>> dp(n+1, vector<int>(m+1, 0));

        for(int ind1=n-1; ind1>=0; ind1--){
            for(int ind2=m-1; ind2>=0; ind2--){
                int ans = 0;
                if(text1[ind1] == text2[ind2]){
                    ans = max(ans, 1 + dp[ind1 + 1][ind2 + 1]);
                }
                ans = max(ans, max(dp[ind1 + 1][ind2], dp[ind1][ind2 + 1]));
                ans = max(ans, dp[ind1 + 1][ind2 + 1]);
                dp[ind1][ind2] = ans;
            }
        }
        return dp[0][0];    
    }
};

// Approach 3 : Space Optimisation
// TC : O(N * M)
// SC : O(M)

class Solution {
public:
    int longestCommonSubsequence(string text1, string text2) {
        int n = text1.size(), m = text2.size();
        vector<int> dp(m+1, 0), curr(m+1, 0);

        for(int ind1=n-1; ind1>=0; ind1--){
            for(int ind2=m-1; ind2>=0; ind2--){
                int ans = 0;
                if(text1[ind1] == text2[ind2]){
                    ans = max(ans, 1 + dp[ind2 + 1]);
                }
                ans = max(ans, max(dp[ind2], curr[ind2 + 1]));
                ans = max(ans, dp[ind2 + 1]);
                curr[ind2] = ans;
            }
            dp = curr;
        }

        return dp[0];    
    }
};

//Printing LCS after DP building
class Solution {
public:
    int longestCommonSubsequence(string text1, string text2) {
        int n = text1.size(), m = text2.size();
        vector<vector<int>> dp(n+1, vector<int>(m+1, 0));

        for(int ind1=n-1; ind1>=0; ind1--){
            for(int ind2=m-1; ind2>=0; ind2--){
                int ans = 0;
                if(text1[ind1] == text2[ind2]){
                    ans = max(ans, 1 + dp[ind1 + 1][ind2 + 1]);
                }
                ans = max(ans, max(dp[ind1 + 1][ind2], dp[ind1][ind2 + 1]));
                ans = max(ans, dp[ind1 + 1][ind2 + 1]);
                dp[ind1][ind2] = ans;
            }
        }
        //printing lcs
        string lcs = "";
        int i = 0, j = 0;
        while(i < n && j < m){
            if(text1[i] == text2[j]){
                lcs += text1[i];
                i++;
                j++;
            }
            else if(dp[i+1][j] >= dp[i][j+1]){
                i++;
            }
            else{
                j++;
            }
        }

        cout<<lcs<<"\n";
        
        return dp[0][0];    
    }
};
