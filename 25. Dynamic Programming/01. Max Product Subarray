class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int n = nums.size();
        int ans = INT_MIN;
        int pre = 1, suff = 1;
        for(int i=0; i<n; i++){
            if(pre == 0) pre = 1;
            if(suff == 0) suff = 1;
            pre *= nums[i];
            suff *= nums[n-i-1];
            ans = max({ans,pre,suff});
        }
        return ans;
    }
};

// Approach 2
class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int n = nums.size();
        int mxp = nums[0], mnp = nums[0];
        int ans = nums[0];
        for(int i=1; i<n; i++){
            int x = nums[i];
            if(x < 0){
                swap(mxp, mnp);
            }

            mxp = max(x, mxp * x);
            mnp = min(x, mnp * x);
            ans = max(ans, mxp);
        }

        return ans;
    }
};
