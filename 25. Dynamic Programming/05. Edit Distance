// Approach : Memoisation
// TC : O(N1 * N2)
// SC : O(N1 * N2) + O(N1 + N2)

class Solution {
public:
    int n1, n2;
    int solve(int i, int j, string &word1, string &word2, vector<vector<int>> &dp){
        if(i == n1){
            return n2 - j;
        }

        if(j == n2){
            return n1 - i;
        }

        if(dp[i][j] != -1) return dp[i][j];

        int ans = 1e9;
        if(word1[i] == word2[j]){
            ans = min(ans, solve(i+1, j+1, word1, word2, dp));
        }

        //insert
        ans = min(ans, 1 + solve(i, j+1, word1, word2, dp));
        //delete
        ans = min(ans, 1 + solve(i+1, j, word1, word2, dp));
        //replace
        ans = min(ans, 1 + solve(i+1, j+1, word1, word2, dp));

        return dp[i][j] = ans;
    }

    int minDistance(string word1, string word2) {
        n1 = word1.size(), n2 = word2.size();
        vector<vector<int>> dp(n1 + 1, vector<int>(n2 + 1, -1));
        return solve(0, 0, word1, word2, dp);
    }
};

// Approach : Tabulation
// TC : O(N1 * N2)
// SC : O(N1 * N2)

class Solution {
public:
    int minDistance(string word1, string word2) {
        int n1 = word1.size(), n2 = word2.size();
        vector<vector<int>> dp(n1 + 1, vector<int>(n2 + 1, 0));

        for (int j = 0; j <= n2; j++) {
            dp[n1][j] = n2 - j;
        }

        for (int i = 0; i <= n1; i++) {
            dp[i][n2] = n1 - i;
        }

        for (int i = n1 - 1; i >= 0; i--) {
            for (int j = n2 - 1; j >= 0; j--) {
                int ans = 1e9;
                if (word1[i] == word2[j]) {
                    ans = min(ans, dp[i+1][j+1]);
                }

                // insert
                ans = min(ans, 1 + dp[i][j+1]);
                // delete
                ans = min(ans, 1 + dp[i+1][j]);
                // replace
                ans = min(ans, 1 + dp[i+1][j+1]);

                dp[i][j] = ans;
            }
        }

        return dp[0][0];
    }
};

// Approach : Space Optimisation
// TC : O(N1 * N2)
// SC : O(N2)

class Solution {
public:
    int minDistance(string word1, string word2) {
        int n1 = word1.size(), n2 = word2.size();
        vector<int> ahead(n2 + 1, 0), curr(n2 + 1, 0);

        for (int j = 0; j <= n2; j++) {
            ahead[j] = n2 - j;
        }

        for (int i = n1 - 1; i >= 0; i--) {
            curr[n2] = n1 - i;
            for (int j = n2 - 1; j >= 0; j--) {
                int ans = 1e9;
                if (word1[i] == word2[j]) {
                    ans = min(ans, ahead[j+1]);
                }

                // insert
                ans = min(ans, 1 + curr[j+1]);
                // delete
                ans = min(ans, 1 + ahead[j]);
                // replace
                ans = min(ans, 1 + ahead[j+1]);

                curr[j] = ans;
            }
            ahead = curr;
        }

        return ahead[0];
    }
};
